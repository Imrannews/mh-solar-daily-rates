rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Anyone can read the public solar rates. Only authenticated admins can change them.
    match /solar_rates/{rateId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Admin records are private. An admin can read their own record.
    match /admins/{adminId} {
      allow read: if isAdmin() && request.auth.uid == adminId;
      allow create, update, delete: if false;
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
